# Copy to .env and fill in. Never commit .env; secrets stay empty in this file.
# Docker Compose reads .env automatically.

# ── Runtime ──────────────────────────────────────────────────
# local | demo
APP_ENV=local
# Unlocks the chaos panel and approvals in the console
DEMO_CODE=
# Shared secret the gateways send in X-Gateway-Token. `make up` fills a random one.
GATEWAY_TOKEN=
# Which parts of compose.yaml to start (comma separated):
#   localdb  MongoDB Atlas Local in Docker (leave out when MONGODB_URI points to Atlas)
#   datadog  Datadog Agent (needs DD_API_KEY and DD_SITE)
#   app      api, brain, edge, web
#   proxy    Caddy with automatic HTTPS (the demo VM only)
COMPOSE_PROFILES=localdb

# ── MongoDB ──────────────────────────────────────────────────
# Leave empty to use the MongoDB container on the same host (profile localdb).
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB=firstlight
# Credentials for the MongoDB container (profile localdb). `make up` fills a random password.
MONGO_ROOT_USER=firstlight
MONGO_ROOT_PASSWORD=
MONGO_MEM_LIMIT=3g

# ── Datadog ──────────────────────────────────────────────────
# Organization Settings → API Keys / Application Keys in the org the organisers give you
DD_API_KEY=
# Needed for dashboards and monitors as code, notebooks and evidence queries
DD_APP_KEY=
# Must match that org, e.g. datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
DD_SITE=
DD_ENV=local
# CI sets this to the git sha
DD_VERSION=dev
DD_LLMOBS_ML_APP=firstlight-investigator
# true once the datadog profile is running; false keeps ddtrace quiet without an Agent
DD_TRACE_ENABLED=false
# Shared secret the Datadog webhook sends in the X-Firstlight-Secret header
WEBHOOK_SECRET=

# ── Web console (Vite: these values end up in the browser) ───
# Digital Experience → RUM → New application; client tokens are public by design
VITE_DD_RUM_APPLICATION_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_SITE=

# ── AI: Gemini (optional, the loop runs without it) ─────────
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Incident-memory embeddings, 768 dimensions. gemini-embedding-2 ignores taskType: queries and documents carry text prefixes instead.
GEMINI_EMBED_MODEL=gemini-embedding-2
# The Gemini Developer API refuses some hosting IPs by location. Vertex AI (Gemini on Google Cloud) does
# not: set GEMINI_VERTEX=true and either put a Vertex AI express-mode key in GEMINI_API_KEY, or a service
# account's JSON, base64 encoded, in GOOGLE_SERVICE_ACCOUNT_B64 (role: Vertex AI User).
GEMINI_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_SERVICE_ACCOUNT_B64=

# ── Simulator ────────────────────────────────────────────────
SIM_FARMS=50
SIM_PONDS_PER_FARM=4
SIM_BATCH_SECONDS=10
# Farm clock = UTC + offset. 7 is Vietnam time, so the simulated ponds see the real day and night.
SIM_FARM_CLOCK_OFFSET_HOURS=7

# ── Incident policy ──────────────────────────────────────────
# Recovered = DO at or above 4 mg/L and not falling for this many minutes (2 for a live demo, 10 on a farm).
RECOVERY_STABLE_MIN=2
# Call a person when a pond has not recovered this many minutes after the action.
ESCALATE_AFTER_MIN=10

# ── Demo host (profile proxy) ────────────────────────────────
# Public hostname Caddy serves over HTTPS, e.g. firstlight.<ip>.sslip.io
PUBLIC_HOST=

# ── Farmer notifications (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A second person who hears when nobody acknowledges within 3 minutes (defaults to the same chat).
TELEGRAM_ESCALATION_CHAT_ID=
# Telegram sends it back on every button press; letters, digits, _ and - only.
TELEGRAM_WEBHOOK_SECRET=

# ── Demo VPS (used by scripts/deploy.sh from your laptop; never copied to the server) ──
VPS_IP=
VPS_USERNAME=root
# Only for the very first login; after that the deploy uses your SSH key. Clear it once the key works.
VPS_PASSWORD=
