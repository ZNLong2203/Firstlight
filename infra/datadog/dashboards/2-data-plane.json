{
  "title": "Firstlight · Data plane",
  "description": "The software that watches the ponds: ingest by version, freshness, the brain's cycle, commands, MongoDB and the logs. Managed by infra/datadog/apply.py.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [{ "name": "env", "prefix": "env", "available_values": [], "default": "__ENV__" }],
  "widgets": [
    {
      "layout": { "x": 0, "y": 0, "width": 6, "height": 4 },
      "definition": {
        "type": "timeseries",
        "title": "Ingest requests per second, by version",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "q": "sum:trace.fastapi.request.hits{$env,service:firstlight-api,resource_name:post_/v1/ingest} by {version}.as_rate()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "layout": { "x": 6, "y": 0, "width": 6, "height": 4 },
      "definition": {
        "type": "timeseries",
        "title": "Ingest latency p95, s, by version",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "q": "p95:trace.fastapi.request{$env,service:firstlight-api,resource_name:post_/v1/ingest} by {version}",
            "display_type": "line"
          }
        ],
        "markers": [{ "value": "y = 0.5", "display_type": "error dashed", "label": "slow ingest" }]
      }
    },
    {
      "layout": { "x": 0, "y": 4, "width": 4, "height": 4 },
      "definition": {
        "type": "timeseries",
        "title": "Readings stored per second",
        "title_size": "16",
        "title_align": "left",
        "requests": [{ "q": "sum:firstlight.ingest.readings{$env}.as_rate()", "display_type": "bars" }]
      }
    },
    {
      "layout": { "x": 4, "y": 4, "width": 4, "height": 4 },
      "definition": {
        "type": "timeseries",
        "title": "How old a batch is when it lands, s",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "q": "avg:firstlight.ingest.lag_seconds{$env}",
            "display_type": "line",
            "metadata": [{ "expression": "avg:firstlight.ingest.lag_seconds{$env}", "alias_name": "average" }]
          },
          {
            "q": "max:firstlight.ingest.lag_seconds{$env}",
            "display_type": "line",
            "style": { "line_type": "dashed" },
            "metadata": [{ "expression": "max:firstlight.ingest.lag_seconds{$env}", "alias_name": "worst" }]
          }
        ]
      }
    },
    {
      "layout": { "x": 8, "y": 4, "width": 4, "height": 4 },
      "definition": {
        "type": "toplist",
        "title": "Stalest gateways, seconds since a reading",
        "title_size": "16",
        "title_align": "left",
        "requests": [{ "q": "top(max:firstlight.pond.freshness_seconds{$env} by {gateway}, 10, 'last', 'desc')" }]
      }
    },
    {
      "layout": { "x": 0, "y": 8, "width": 4, "height": 3 },
      "definition": {
        "type": "timeseries",
        "title": "The brain's cycle, s",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "q": "avg:firstlight.brain.cycle_s{$env}",
            "display_type": "line",
            "metadata": [{ "expression": "avg:firstlight.brain.cycle_s{$env}", "alias_name": "average" }]
          },
          {
            "q": "max:firstlight.brain.cycle_s{$env}",
            "display_type": "line",
            "style": { "line_type": "dashed" },
            "metadata": [{ "expression": "max:firstlight.brain.cycle_s{$env}", "alias_name": "longest" }]
          }
        ],
        "markers": [{ "value": "y = 10", "display_type": "error dashed", "label": "promised" }]
      }
    },
    {
      "layout": { "x": 4, "y": 8, "width": 4, "height": 3 },
      "definition": {
        "type": "timeseries",
        "title": "Command acknowledged by the gateway, ms",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [{ "q": "avg:firstlight.command.ack_latency_ms{$env} by {action}", "display_type": "line" }]
      }
    },
    {
      "layout": { "x": 8, "y": 8, "width": 4, "height": 3 },
      "definition": {
        "type": "timeseries",
        "title": "MongoDB calls per second, by service",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [{ "q": "sum:trace.pymongo.cmd.hits{$env} by {service}.as_rate()", "display_type": "line" }]
      }
    },
    {
      "layout": { "x": 0, "y": 11, "width": 12, "height": 3 },
      "definition": {
        "type": "timeseries",
        "title": "Warnings and errors from the services, per minute",
        "title_size": "16",
        "title_align": "left",
        "show_legend": true,
        "requests": [
          {
            "display_type": "bars",
            "style": { "palette": "warm" },
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "logs",
                "name": "q",
                "search": { "query": "env:__ENV__ service:firstlight-* status:(warn OR error)" },
                "indexes": ["*"],
                "group_by": [{ "facet": "status", "limit": 5, "sort": { "aggregation": "count", "order": "desc" } }],
                "compute": { "aggregation": "count" }
              }
            ],
            "formulas": [{ "formula": "q" }]
          }
        ]
      }
    }
  ]
}
